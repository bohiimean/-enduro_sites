# ---- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_DB=enduro
POSTGRES_USER=enduro
POSTGRES_PASSWORD=enduro
DATABASE_URL=postgres://enduro:enduro@postgres:5432/enduro

# ---- Порт, на котором nginx отдаёт сайт ----------------------------------
HTTP_PORT=8080

# ---- Nuxt ----------------------------------------------------------------
# Внутренний адрес для SSR-запросов из контейнера frontend в контейнер backend.
# Публичный адрес (для браузера) относительный — его проксирует nginx.
NUXT_API_INTERNAL_BASE=http://backend:8000/api/v1
NUXT_PUBLIC_API_BASE=/api/v1

# ---- Сервис курсов -------------------------------------------------------
# Боевое место сервиса — зарубежный VPS, там будет https://rates.<домен>.
# Для разработки он поднимается профилем: docker compose --profile rates up -d
RATE_SERVICE_URL=http://rates:8001
RATE_SERVICE_TOKEN=dev-token
RATE_REFRESH_MINUTES=20
# Какие источники опрашивает локальный сервис курсов.
# investing — это headless Chromium: образ тяжёлый, памяти нужно от 2 ГБ.
# Если мешает, уберите его отсюда — остальные два обычные HTTP-запросы.
SOURCES_ENABLED=rapira,investing,alfabit_showcase

# ---- Alfabit (этап 4) ----------------------------------------------------
ALFABIT_API_KEY=
ALFABIT_SECRET_KEY=
ALFABIT_BASE_URL=https://alfabit.org
ALFABIT_RATE_DIRECTION=buy

# ---- Подтверждение номера (этап 5, каналы не выбраны) --------------------
# MAX_BOT_TOKEN=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_NAME=

# ---- Уведомления менеджеру ------------------------------------------------
MANAGER_TG_CHAT_ID=
