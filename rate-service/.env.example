# Токен, которым российский сервер представляется сервису. Обязателен.
RATE_SERVICE_TOKEN=change-me

# Какие источники опрашивать на этой машине.
# На зарубежном VPS — все три. Локально investing обычно выключают: это
# headless Chromium и 2–3 минуты на вызов.
SOURCES_ENABLED=rapira,investing,alfabit_showcase

# Как часто обновлять котировки.
REFRESH_MINUTES=20

# investing.com
CHROME_BINARY_PATH=/usr/bin/chromium
# Пороги watchdog'а. Нормальный скрап долгий: первый ~3 мин, дальше ~2 мин.
INVESTING_BROWSER_TIMEOUT=420
INVESTING_GET_RATE_TIMEOUT=900
# Запасной источник USD/RUB, если investing не отдался.
TWELVEDATA_API_KEY=

# alfabit: публичные эндпоинты витрины ключей не требуют. Ключи нужны только
# для подписанного запасного пути — см. providers/alfabit.py.
ALFABIT_BASE_URL=https://alfabit.org
ALFABIT_RATE_DIRECTION=buy
ALFABIT_API_KEY=
ALFABIT_SECRET_KEY=
# Комиссия метода оплаты на случай, если список методов у alfabit пуст
# (22.09.2026 /public/buy-sell/banks/RUB отдаёт HTTP 200 и пустой список).
# Пусто — курс витрины просто не отдаётся. Включать осознанно: с неверным
# значением цена уедет молча.
ALFABIT_FEE_PERCENT_FALLBACK=
